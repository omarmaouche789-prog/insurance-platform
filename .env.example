# Postgres (system of record) — Railway.app connection string
DATABASE_URL=postgresql://postgres:HRlIZxMVyDmyNSNxDXRpDwIeCTbOMWVM@postgres.railway.internal:5432/railway

# Redis (sessions & hot-read caching, wired in Phase 6) — Redis Cloud connection string
REDIS_URL=redis://user:password@host:port

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Ports
API_PORT=4000
WEB_PORT=3000

# CORS: the web app's origin, for local dev when not using the Next.js rewrite
WEB_ORIGIN=http://localhost:3000

# Field-level encryption for SSNs and health info (AES-256-GCM): 32 random bytes, base64.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes existing encrypted fields unreadable — back it up per environment.
FIELD_ENCRYPTION_KEY=

# ─── Integrations ────────────────────────────────────────────────────────────
# Each integration uses its real service when configured and a local mock
# otherwise. With NODE_ENV=production the API refuses to start unless all of
# them are configured, or ALLOW_MOCK_INTEGRATIONS=true (staging only).
# Full reference: DEPLOYMENT.md.
ALLOW_MOCK_INTEGRATIONS=

# Base URL of the web app, used for links in emails.
APP_URL=http://localhost:3000

# Document storage: S3 when AWS_S3_BUCKET is set, else local disk at STORAGE_DIR
# (relative to apps/api; dev only — PaaS disks are wiped on deploy).
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: customer-managed KMS key (default is SSE-S3/AES256), key prefix per environment.
AWS_S3_KMS_KEY_ID=
AWS_S3_PREFIX=
STORAGE_DIR=storage

# Email: SendGrid when SENDGRID_API_KEY is set, else logged to the console.
# EMAIL_FROM must be a sender verified in SendGrid.
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Insurance Marketplace

# ZIP lookup: SmartyStreets US ZIP Code API (secret key pair) when set, else a
# static table. Falls back to the table automatically if Smarty is unreachable.
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=

# Carrier APIs, one pair per carrier code (BLUEPEAK, MERIDIAN, SUMMIT, HARBOR in
# the seed data). Carriers without a pair use the mock outside production.
# CARRIER_BLUEPEAK_API_URL=https://api.bluepeak.example/v1
# CARRIER_BLUEPEAK_API_KEY=

# Reverse-proxy hops in front of the API (1 on Render), for accurate client IPs
# in audit logs, login history and rate limiting. Set this correctly in
# production: with 0 behind a proxy, every user shares one rate-limit bucket.
TRUST_PROXY=0

# ─── Seed data (dev/staging only) ────────────────────────────────────────────
# true = `prisma:seed` also creates ~60 fictional users with six months of
# applications, decisions and commissions, so the analytics dashboard has data.
SEED_DEMO_DATA=false

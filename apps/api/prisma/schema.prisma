generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  AGENT
  ADMIN
}

enum AdminRole {
  SUPER
  OPERATIONS
  COMPLIANCE
  FINANCE
}

// Guest has no account and therefore no row here — it's the absence of a session.
model User {
  id               String     @id @default(uuid())
  email            String     @unique
  passwordHash     String
  role             Role
  adminRole        AdminRole?
  firstName        String
  lastName         String
  phone            String?
  isActive         Boolean    @default(true)
  emailVerifiedAt  DateTime?
  // Mirrors two_factor_secrets.enabledAt so lists/filters don't need a join;
  // both are written together in modules/security/twoFactor.service.ts.
  twoFactorEnabled Boolean    @default(false)
  // Suspension is reversible (isActive=false plus a reason). Deletion is a
  // soft delete that also anonymizes the row — see modules/admin/users.service.ts.
  suspendedAt      DateTime?
  suspensionReason String?
  deletedAt        DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  agentProfile         AgentProfile?
  twoFactorSecret      TwoFactorSecret?
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  applications         Application[]        @relation("Applicant")
  // Agent side of the relations; empty for non-agents.
  assignedApplications Application[]        @relation("AssignedAgent")
  documentRequests     DocumentRequest[]    @relation("DocumentRequestAgent")
  commissions          Commission[]
  reviewedApplications Application[]        @relation("Reviewer")
  backupCodes          BackupCode[]
  loginHistory         LoginHistory[]
  passwordResetTokens  PasswordResetToken[] @relation("ResetTokenOwner")
  issuedResetTokens    PasswordResetToken[] @relation("ResetTokenIssuer")
  notifications        Notification[]
  followUps            FollowUp[]
  applicationNotes     ApplicationNote[]
  blogPosts            BlogPost[]
  completedDocRequests DocumentRequest[]    @relation("DocumentRequestCompleter")
  SmsTemplate          SmsTemplate[]
  SystemSetting        SystemSetting[]

  @@index([role, isActive])
  @@index([createdAt])
  @@map("users")
}

model AgentProfile {
  userId            String    @id
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber     String
  // National Producer Number, optional until licensing verification exists.
  npn               String?
  licenseExpiresAt  DateTime? @db.Date
  // Two-letter state codes the agent is licensed in; drives auto-assignment.
  regions           String[]
  // Agent-specific override of the carrier rate, in basis points of
  // annualized premium. Null = use the carrier's CommissionRate.
  commissionRateBps Int?
  isActive          Boolean   @default(true)
  deactivatedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@map("agent_profiles")
}

// The TOTP secret, AES-256-GCM encrypted at rest (lib/fieldCrypto.ts). Rows
// written before encryption was added hold the plaintext secret and are
// re-encrypted on next use — see readTotpSecret().
model TwoFactorSecret {
  userId       String    @id
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret       String
  enabledAt    DateTime?
  // The last 30-second TOTP time step that was accepted. Codes from that
  // step or earlier are refused, so an intercepted code can't be replayed.
  lastUsedStep Int?
  createdAt    DateTime  @default(now())

  @@map("two_factor_secrets")
}

// One-time 2FA recovery codes. Only an HMAC of each code is stored; the
// plaintext is shown to the user exactly once.
model BackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("backup_codes")
}

enum LoginMethod {
  PASSWORD
  TOTP
  BACKUP_CODE
  PASSWORD_RESET
}

// Every sign-in attempt against a real account, successful or not.
model LoginHistory {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  success       Boolean
  method        LoginMethod
  failureReason String?
  ipAddress     String?
  userAgent     String?
  // Human-readable summary parsed from the user agent, e.g. "Chrome on macOS".
  device        String?
  createdAt     DateTime    @default(now())

  @@index([userId, createdAt])
  @@map("login_history")
}

enum PasswordResetPurpose {
  RESET
  // A newly created account (e.g. an admin-created agent) setting its first password.
  INVITE
}

model PasswordResetToken {
  id            String               @id @default(uuid())
  userId        String
  user          User                 @relation("ResetTokenOwner", fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the token; the raw token only ever exists in the emailed link.
  tokenHash     String               @unique
  purpose       PasswordResetPurpose @default(RESET)
  requestedById String?
  requestedBy   User?                @relation("ResetTokenIssuer", fields: [requestedById], references: [id], onDelete: SetNull)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime             @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// In-app notifications (bell in the portal header). Bodies are shown only
// after sign-in, but still stay PHI-light: names and a link, no health data.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Points at the token this one was rotated into, so a near-simultaneous
  // duplicate refresh call (e.g. React StrictMode's double-invoked mount
  // effect, or two tabs refreshing around the same moment) can be resolved
  // forward instead of failing the session — see refreshSession().
  replacedByTokenId String?       @unique
  replacedBy        RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  replacedFrom      RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@map("audit_logs")
}

// ─── Phase 2: plan catalog ───────────────────────────────────────────────────
// All money columns are integer cents to avoid Decimal serialization and
// float rounding; format for display at the edge.

enum MetalTier {
  CATASTROPHIC
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PlanType {
  HMO
  PPO
  EPO
  POS
}

model Carrier {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  plans          Plan[]
  commissionRate CommissionRate?
  commissions    Commission[]

  @@map("carriers")
}

model Plan {
  id                    String    @id @default(uuid())
  carrierId             String
  carrier               Carrier   @relation(fields: [carrierId], references: [id])
  name                  String
  planYear              Int
  metalTier             MetalTier
  planType              PlanType
  monthlyPremiumCents   Int
  deductibleCents       Int
  outOfPocketMaxCents   Int
  primaryCareCopayCents Int
  specialistCopayCents  Int
  genericDrugCopayCents Int
  hsaEligible           Boolean   @default(false)
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  serviceAreas PlanServiceArea[]
  applications Application[]

  @@unique([carrierId, name, planYear])
  @@index([metalTier])
  @@map("plans")
}

// A plan is sold in a set of ZIP codes. Kept as a join table (rather than a
// String[] on Plan) so "plans in ZIP X" is an indexed lookup.
model PlanServiceArea {
  planId  String
  plan    Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  zipCode String @db.Char(5)

  @@id([planId, zipCode])
  @@index([zipCode])
  @@map("plan_service_areas")
}

// ─── Phase 3: enrollment applications ────────────────────────────────────────

// SUBMITTED = carrier accepted receipt, awaiting admin review.
// REJECTED  = declined by the carrier (submissionStatus REJECTED/FAILED; an
//             agent can resubmit) or by an admin (submissionStatus ACCEPTED;
//             final).
// APPROVED  = approved by an admin.
enum ApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// Carrier-side outcome, tracked separately from our own workflow status.
// PENDING doubles as a submit lock so a double-click can't submit twice.
enum CarrierSubmissionStatus {
  NOT_SUBMITTED
  PENDING
  ACCEPTED
  REJECTED
  FAILED
}

// PHOTO_ID and PROOF_OF_ADDRESS are required to submit; the rest are only
// collected when an agent requests them.
enum DocumentType {
  PHOTO_ID
  PROOF_OF_ADDRESS
  PROOF_OF_INCOME
  OTHER
}

model Application {
  id      String            @id @default(uuid())
  userId  String
  user    User              @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  // Assigned at creation to an agent licensed in the applicant's state; null
  // when none is available (admins assign manually in Phase 5).
  agentId String?
  agent   User?             @relation("AssignedAgent", fields: [agentId], references: [id], onDelete: SetNull)
  planId  String
  plan    Plan              @relation(fields: [planId], references: [id])
  status  ApplicationStatus @default(DRAFT)

  firstName           String
  lastName            String
  dateOfBirth         DateTime @db.Date
  // Nullable only for rows created before Phase 4; the API requires it.
  zipCode             String?  @db.Char(5)
  // SSN and health info are AES-256-GCM encrypted (lib/fieldCrypto.ts);
  // only the SSN's last 4 digits are stored in the clear, for display.
  ssnEncrypted        String
  ssnLast4            String   @db.Char(4)
  healthInfoEncrypted String?

  submissionStatus   CarrierSubmissionStatus @default(NOT_SUBMITTED)
  carrierReference   String?
  carrierMessage     String?
  submittedAt        DateTime?
  submissionAttempts Int                     @default(0)

  // Admin decision (Phase 5). reviewNotes is the rejection reason (shown to
  // the applicant and agent) or internal approval notes (admins only).
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("Reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents        ApplicationDocument[]
  documentRequests DocumentRequest[]
  commission       Commission?
  followUps        FollowUp[]
  notes            ApplicationNote[]

  @@index([userId])
  @@index([createdAt])
  @@index([agentId, status])
  @@index([status, submittedAt])
  @@map("applications")
}

// One file per document type per application; re-uploading replaces it.
model ApplicationDocument {
  id            String       @id @default(uuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          DocumentType
  fileName      String
  mimeType      String
  sizeBytes     Int
  storageKey    String       @unique
  uploadedAt    DateTime     @default(now())

  @@unique([applicationId, type])
  @@map("application_documents")
}

// ─── Phase 4: agent tooling & commissions ────────────────────────────────────

// OPEN      → waiting on the applicant.
// FULFILLED → every requested type was uploaded after the request (automatic;
//             resolvedAt is set at the same time).
// COMPLETED → the agent reviewed the uploads and closed the request.
// CANCELLED → withdrawn by the agent.
enum DocumentRequestStatus {
  OPEN
  FULFILLED
  COMPLETED
  CANCELLED
}

// An agent asking the applicant for more documents.
model DocumentRequest {
  id             String                @id @default(uuid())
  applicationId  String
  application    Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          User                  @relation("DocumentRequestAgent", fields: [agentId], references: [id])
  message        String
  requestedTypes DocumentType[]
  status         DocumentRequestStatus @default(OPEN)
  createdAt      DateTime              @default(now())
  // When the applicant's uploads satisfied the request (FULFILLED). Also set
  // on COMPLETED/CANCELLED so "open" is always resolvedAt IS NULL.
  resolvedAt     DateTime?
  completedAt    DateTime?
  completedById  String?
  completedBy    User?                 @relation("DocumentRequestCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@map("document_requests")
}

// A reminder an agent sets on an application (call the applicant back, etc.).
model FollowUp {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  agentId       String
  agent         User        @relation(fields: [agentId], references: [id])
  dueAt         DateTime
  note          String
  completedAt   DateTime?
  createdAt     DateTime    @default(now())

  @@index([agentId, completedAt, dueAt])
  @@index([applicationId])
  @@map("follow_ups")
}

// Internal notes on an application, visible to agents and admins only —
// never to the applicant.
model ApplicationNote {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  body          String
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
  @@map("application_notes")
}

// Placeholder per-carrier rates until real rate tables exist (CLAUDE.md lists
// them as unresolved). Basis points of annualized premium: 500 = 5.00%.
model CommissionRate {
  carrierId String   @id
  carrier   Carrier  @relation(fields: [carrierId], references: [id])
  rateBps   Int
  updatedAt DateTime @updatedAt

  @@map("commission_rates")
}

// PENDING when the carrier accepts, EARNED at admin approval, VOID at admin
// rejection, PAID by finance (Phase 7).
enum CommissionStatus {
  PENDING
  EARNED
  PAID
  VOID
}

// One commission per application, snapshotting the premium and rate at the
// time it was created so later rate changes don't rewrite history.
model Commission {
  id            String           @id @default(uuid())
  applicationId String           @unique
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  agentId       String
  agent         User             @relation(fields: [agentId], references: [id])
  carrierId     String
  carrier       Carrier          @relation(fields: [carrierId], references: [id])
  premiumCents  Int
  rateBps       Int
  amountCents   Int
  status        CommissionStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([agentId, status])
  @@index([carrierId, createdAt])
  @@map("commissions")
}

// ─── CMS ─────────────────────────────────────────────────────────────────────

// A PUBLISHED post with a future publishedAt is "scheduled": the public blog
// only lists posts where status = PUBLISHED and publishedAt <= now().
enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id                String         @id @default(uuid())
  title             String
  slug              String         @unique
  excerpt           String?
  // Sanitized HTML from the rich text editor (modules/cms/sanitize.ts).
  content           String
  status            BlogPostStatus @default(DRAFT)
  publishedAt       DateTime?
  authorId          String?
  author            User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  featuredImageKey  String?
  featuredImageMime String?
  featuredImageAlt  String?
  seoTitle          String?
  seoDescription    String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, publishedAt])
  @@map("blog_posts")
}

// ─── Notification templates ──────────────────────────────────────────────────

// Admin edits to SMS templates. The template catalog and default wording
// live in code (modules/admin/notificationTemplates.ts); a row exists only
// once an admin has customized or switched off a template.
model SmsTemplate {
  key         String   @id
  body        String
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("sms_templates")
}

// ─── System settings ─────────────────────────────────────────────────────────

// One row per settings section ("features", "maintenance", "session"),
// value is JSON. Missing rows/fields fall back to SYSTEM_SETTINGS_DEFAULTS
// in shared, so new settings need no migration or seed.
model SystemSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}
